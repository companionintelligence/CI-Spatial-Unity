<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:installLocation="auto">
  <!-- networkSecurityConfig: generated per build by CompanionScan.Editor.AndroidNetworkSecurityConfig
       (HTTPS only; development builds also allow http to ServerConfig's development cleartext hosts). -->
  <application android:label="@string/app_name" android:icon="@mipmap/app_icon" android:allowBackup="false" android:networkSecurityConfig="@xml/companion_network_security_config">
    <activity android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" android:configChanges="locale|fontScale|keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode" android:launchMode="singleTask" android:name="com.unity3d.player.UnityPlayerGameActivity" android:excludeFromRecents="true" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="com.oculus.intent.category.VR" />
      </intent-filter>
      <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
    </activity>
    <meta-data android:name="unityplayer.SkipPermissionsDialog" android:value="false" />
    <meta-data android:name="com.oculus.handtracking.frequency" android:value="LOW" />
    <meta-data android:name="com.oculus.ossplash.background" android:value="passthrough-contextual" />
    <meta-data android:name="com.oculus.telemetry.project_guid" android:value="be1cb618-05aa-4c09-890b-003e0d74dc0c" />
    <!-- Quest 3 and 3S only: the Passthrough Camera API that frame capture needs exists only on these headsets. -->
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s" />
  </application>
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
  <uses-feature android:name="oculus.software.handtracking" android:required="false" />
  <!-- Horizon OS system keyboard, used to enter the CV server URL in-headset (SettingsPanel). -->
  <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />
  <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
  <uses-permission android:name="com.oculus.permission.USE_ANCHOR_API" />
  <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="true" />
  <uses-permission android:name="com.oculus.permission.USE_SCENE" />
  <!-- Passthrough Camera API (Quest 3 / 3S, Horizon OS v74+). PassthroughCameraPermission requests both at run
       time when capture starts, and the camera starts only once both are granted: MobileCameraProvider (AR
       Foundation and Meta OpenXR, the path the scene uses) and the QuestCameraProvider WebCamTexture fallback.
       android.permission.CAMERA stays until capture is verified on a headset without it: Meta OpenXR opens the
       passthrough cameras through Android's NDK Camera2 API, which checks it, and adds it to the merged manifest
       itself while camera image support is on, so dropping it would also need tools:node="remove". -->
  <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Added at build time by enabled Unity OpenXR / Meta OpenXR features (Foveated Rendering with a
       Quest Pro target, AR Anchors, Colocation Discovery, Boundary Visibility) but unused by this app:
       it calls no eye gaze, eye-tracked foveation, anchor sharing, colocation or boundary visibility APIs.
       tools:node="remove" drops them from the merged manifest. -->
  <uses-permission android:name="com.oculus.permission.EYE_TRACKING" tools:node="remove" />
  <uses-feature android:name="oculus.software.eye_tracking" tools:node="remove" />
  <uses-permission android:name="com.oculus.permission.IMPORT_EXPORT_IOT_MAP_DATA" tools:node="remove" />
  <uses-permission android:name="com.oculus.permission.USE_COLOCATION_DISCOVERY_API" tools:node="remove" />
  <uses-permission android:name="com.oculus.permission.BOUNDARY_VISIBILITY" tools:node="remove" />
</manifest>