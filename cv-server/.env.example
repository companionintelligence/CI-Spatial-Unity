# Copy to cv-server/.env (gitignored) for `docker compose`. Never commit real values.

# Required. Bearer token(s) for every endpoint, /v1/health included; comma-separate
# two tokens while rotating. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CV_SERVER_API_TOKEN=

# Optional TLS. Put the certificate and key in cv-server/certs/ and give their
# paths inside the container. Defaults: /app/certs/server.crt and server.key.
# With both files it serves HTTPS on :443 only (no plain-HTTP listener); without
# them, plain HTTP on :8000 only. One file without the other stops the container.
# Set CV_SERVER_REQUIRE_TLS=1 to refuse to start without TLS.
#CV_SERVER_REQUIRE_TLS=1
#CV_SERVER_SSL_CERTFILE=/app/certs/<your-host>.crt
#CV_SERVER_SSL_KEYFILE=/app/certs/<your-host>.key

# Optional request size caps (bytes): HTTP bodies (images, glTF uploads; 413
# above it) and WebSocket messages on /v1/stream.
#CV_SERVER_MAX_REQUEST_BYTES=33554432
#CV_SERVER_MAX_WS_MESSAGE_BYTES=16777216

# Optional. 0 skips fetching/verifying the model files on start.
#CV_SERVER_FETCH_WEIGHTS=1
