# Copy to cv-server/.env (gitignored) for `docker compose`. Never commit real values.

# Required. Bearer token(s) for every endpoint except /v1/health; comma-separate
# two tokens while rotating. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CV_SERVER_API_TOKEN=

# Optional TLS. Put the certificate and key in cv-server/certs/ and give their
# paths inside the container. Defaults: /app/certs/server.crt and server.key.
# Without both files the server serves plain HTTP on :8000 only.
#CV_SERVER_SSL_CERTFILE=/app/certs/<your-host>.crt
#CV_SERVER_SSL_KEYFILE=/app/certs/<your-host>.key

# Optional. 0 skips fetching/verifying the model files on start.
#CV_SERVER_FETCH_WEIGHTS=1
