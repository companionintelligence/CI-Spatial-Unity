#!/usr/bin/env bash
# Stub keytool: "keytool -printcert -jarfile <aab>" prints $STUB_CASE/keytool-printcert.txt.
set -euo pipefail

if [ "$#" -ne 3 ] || [ "$1" != -printcert ] || [ "$2" != -jarfile ] || [ ! -f "$3" ]; then
  echo "stub keytool: unexpected arguments: $*" >&2
  exit 2
fi
tr -d '\r' < "$STUB_CASE/keytool-printcert.txt"
