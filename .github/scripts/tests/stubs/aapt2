#!/usr/bin/env bash
# Stub aapt2: "aapt2 dump badging <apk>" prints $STUB_CASE/aapt2-badging.txt.
set -euo pipefail

if [ "$#" -ne 3 ] || [ "$1" != dump ] || [ "$2" != badging ] || [ ! -f "$3" ]; then
  echo "stub aapt2: unexpected arguments: $*" >&2
  exit 2
fi
tr -d '\r' < "$STUB_CASE/aapt2-badging.txt"
